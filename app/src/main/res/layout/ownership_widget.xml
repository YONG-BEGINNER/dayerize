<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#202528">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dayerize" android:textColor="#FFAA3C" android:textSize="16sp" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" />
    <TextView android:id="@+id/widget_favourites" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FFFFFF" android:maxLines="3" android:ellipsize="end" />
    <Button android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/add_asset" />
</LinearLayout>
